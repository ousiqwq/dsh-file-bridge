{
  "name": "dsh-plugin-file-bridge",
  "version": "0.1.1",
  "description": "Download files to the current browser from DeepSeek Harness, alongside its native previews",
  "type": "module",
  "exports": {".": "./index.js", "./client": "./client.js", "./cordis.patch.yml": "./cordis.patch.yml", "./package.json": "./package.json"},
  "files": ["index.js", "download.js", "client.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {"test": "node --test tests/*.test.js", "test:browser": "node tests/browser.mjs", "check": "node scripts/check.mjs"},
  "engines": {"node": ">=22"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"]}},
  "author": {"name": "osiqwq", "email": "pc3456789a@gmail.com"},
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/ousiqwq/dsh-file-bridge.git"},
  "homepage": "https://github.com/ousiqwq/dsh-file-bridge#readme",
  "bugs": {"url": "https://github.com/ousiqwq/dsh-file-bridge/issues"},
  "keywords": ["deepseek-harness", "dsh-plugin", "download", "remote", "file"]
}
